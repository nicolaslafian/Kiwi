@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap');

:root {
    --bg-gradient: linear-gradient(135deg, #e0f2fe 0%, #f0f9ff 50%, #ffffff 100%);
    --card-bg: #ffffff;
    --primary-blue: #7dd3fc;
    --primary-hover: #38bdf8;
    --accent-blue: #0284c7;
    --text-main: #334155;
    --text-muted: #64748b;
    --input-bg: #f8fafc;
    --border-color: #bae6fd;
    --shadow-soft: 0 10px 25px -5px rgba(186, 230, 253, 0.4), 0 8px 10px -6px rgba(186, 230, 253, 0.2);
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
    font-family: 'Poppins', sans-serif;
}

body {
    background: var(--bg-gradient);
    min-height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    color: var(--text-main);
    padding: 20px;
}

#bienvenida, #formulario {
    background: var(--card-bg);
    width: 100%;
    max-width: 520px;
    padding: 40px 35px;
    border-radius: 20px;
    box-shadow: var(--shadow-soft);
    border: 1px solid rgba(255, 255, 255, 0.8);
    backdrop-filter: blur(8px);
    text-align: center;
    animation: fadeIn 0.4s ease-in-out;
}

h1 {
    color: var(--accent-blue);
    font-size: 1.8rem;
    font-weight: 600;
    margin-bottom: 8px;
}

h2 {
    color: var(--text-muted);
    font-size: 1.1rem;
    font-weight: 400;
    margin-bottom: 28px;
}

h3 {
    color: var(--text-main);
    font-size: 1.1rem;
    margin-top: 25px;
    margin-bottom: 15px;
    text-align: left;
}

#total {
    background-color: #e0f2fe;
    color: var(--accent-blue);
    padding: 2px 10px;
    border-radius: 12px;
    font-weight: 600;
}

input, select {
    width: 100%;
    padding: 14px 18px;
    margin-bottom: 16px;
    border: 1.5px solid var(--border-color);
    border-radius: 12px;
    background-color: var(--input-bg);
    color: var(--text-main);
    font-size: 0.95rem;
    outline: none;
    transition: all 0.3s ease;
}

input:focus, select:focus {
    border-color: var(--primary-hover);
    background-color: #ffffff;
    box-shadow: 0 0 0 4px rgba(125, 211, 252, 0.25);
}

button {
    width: 100%;
    padding: 14px 20px;
    border: none;
    border-radius: 12px;
    background-color: var(--primary-blue);
    color: #ffffff;
    font-size: 1rem;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 12px rgba(125, 211, 252, 0.4);
}

button:hover {
    background-color: var(--primary-hover);
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(56, 189, 248, 0.4);
}

button:active {
    transform: translateY(0);
}

#buscar {
    width: calc(100% - 110px);
    display: inline-block;
    margin-bottom: 0;
    margin-right: 8px;
}

#formulario button[onclick="buscarPaciente()"] {
    width: 100px;
    display: inline-block;
    background-color: #bae6fd;
    color: #0369a1;
}

#formulario button[onclick="buscarPaciente()"]:hover {
    background-color: #7dd3fc;
}

#lista {
    list-style: none;
    text-align: left;
    max-height: 220px;
    overflow-y: auto;
    padding-right: 5px;
}

#lista li {
    background-color: #f8fafc;
    border-left: 4px solid var(--primary-blue);
    padding: 12px 16px;
    margin-bottom: 10px;
    border-radius: 8px;
    font-size: 0.95rem;
    color: var(--text-main);
    box-shadow: 0 2px 5px rgba(0,0,0,0.02);
}

#mensaje {
    margin-top: 15px;
    font-size: 0.9rem;
    color: var(--accent-blue);
    font-weight: 500;
}

@keyframes fadeIn {
    from {
        opacity: 0;
        transform: translateY(12px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}
